<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/assets/styles/style.css" />
    <img src="/assets/images/random.jpg" alt="Billede af random" />
    <title>Document</title>
  </head>
  <body>
    <main>
      <section>
        <article class="answers">
          <h1>🙈 Chatbot about me 🙈</h1>
          <form method="POST" action="/ask">
            <textarea
              type="text"
              id="question"
              name="question"
              placeholder="Skriv en besked til mig"
              required
            ></textarea>
            <button type="submit">Ask</button>
          </form>

<% for (const message of messages) { %>
  
  <article class="tekstboks <%= message.type %>">
    <p><%= message.text %></p>
  </article>
<% } %>

<% if (error) { %>
  <p role="alert"><%= error %></p>
<% } %>

<h2>Spørgsmål fordelt på emner</h2>
<ul>
  <li>Navn: <%= topicStats.navn %></li>
  <li>By: <%= topicStats.by %></li>
  <li>Hobby: <%= topicStats.hobby %></li>
</ul>
        </article>
      </section>
    </main>
  </body>
</html>
